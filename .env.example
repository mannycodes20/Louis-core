# Copy to .env and change what you like. Everything is optional.
BOT_NAME=Louis
USER_NAME=Emmanuel
OLLAMA_MODEL=qwen3:8b
TEMPERATURE=0.6
VOICE_ENABLED=true
# Words that wake Louis up (Whisper sometimes hears "Lewis" or "Louie")
WAKE_WORDS=louis,lewis,louie,luis,looey
# Lower this if Louis doesn't hear you, raise it if background noise wakes him
MIC_SENSITIVITY=3.0
PIPER_VOICE=en_GB-alan-medium
PORT=8765
